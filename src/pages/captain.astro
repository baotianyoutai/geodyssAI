---
// src/pages/captain.astro
import { CaptainAbyssView } from '../components/CaptainAbyssView';
import '../styles/global.css';
export const prerender = true;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>キャプテン自己紹介 ＆ Z軸潜航 — Captain's Profile | geodyssAI</title>
    <meta name="description" content="AI Systems Architect Yuta のポートフォリオ。3D カメラが Z 軸深海アビスへ潜航するインタラクティブ自己紹介。" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#02040A] text-slate-100 font-body antialiased min-h-screen relative flex flex-col justify-between">
    
    {/* ヘッダーナビゲーション */}
    <header className="p-4 md:p-6 flex items-center justify-between border-b border-slate-800/60 bg-slate-950/60 backdrop-blur-md sticky top-0 z-40">
      <a href="/" className="flex items-center gap-2 group">
        <span className="text-xl">🌌</span>
        <span className="font-display font-bold text-sm tracking-wider text-slate-200 group-hover:text-sky-300 transition-colors">
          geodyssAI
        </span>
      </a>

      <nav className="flex items-center gap-4 text-xs font-mono text-slate-400">
        <a href="/" className="hover:text-white transition-colors">
          ← 星海図 (Chart)
        </a>
        <a href="/observatory" className="px-3 py-1 bg-slate-900 hover:bg-sky-500 hover:text-slate-950 border border-slate-800 rounded-lg text-slate-200 transition-all">
          📡 Observatory
        </a>
      </nav>
    </header>

    {/* メイン コンテンツ */}
    <main className="py-6 px-4 flex-1 max-w-6xl mx-auto w-full space-y-6">
      <div className="text-center space-y-2">
        <span className="text-xs font-mono tracking-widest text-indigo-400 uppercase bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
          CAPTAIN'S LOG & ABYSS DESCEND
        </span>
        <h1 className="text-2xl md:text-4xl font-bold font-display text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-indigo-300 to-purple-400">
          Yuta — Captain's Profile
        </h1>
        <p className="text-xs md:text-sm text-slate-400 max-w-xl mx-auto leading-relaxed">
          「DESCEND ABYSS (潜航)」ボタンを押すことで、3D カメラが Z 軸深海へ潜り、主要なスキル・研究実績ノードを観測できます。
        </p>
      </div>

      <CaptainAbyssView client:only="react" />
    </main>

    {/* フッター */}
    <footer className="border-t border-slate-800/40 py-6 text-center text-xs font-mono text-slate-500 bg-slate-950/40">
      © 2026 geodyssAI. Captain's Log & Abyss Visualizer.
    </footer>
  </body>
</html>
