---
// src/components/MunchkinSpeech.astro
interface Props {
  name?: string;
  icon?: string;
}

const { name = '航海士マンチカン', icon = 'cat' } = Astro.props;
---
<div class="flex gap-4 p-5 my-6 bg-surface-container-low/80 border border-outline-variant/30 rounded-xl backdrop-blur-sm shadow-lg max-w-2xl">
  <div class="flex-shrink-0">
    <img 
      src={`/assets/${icon}.jpg`} 
      alt={name} 
      class="w-12 h-12 rounded-full border border-primary/20 shadow-inner"
    />
  </div>
  <div>
    <div class="font-mono text-xs text-primary font-bold tracking-wide">{name}</div>
    <div class="mt-1.5 text-slate-200 text-sm leading-relaxed">
      <slot />
    </div>
  </div>
</div>
